{
  "name": "balary",
  "version": "0.1.0",
  "private": true,
  "description": "Confidential USDM payroll on Midnight",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:model": "node --test test/*.test.mjs",
    "check:contracts": "node scripts/contract-static-check.mjs",
    "compile": "./scripts/compile.sh",
    "verify": "./scripts/verify.sh",
    "compile:mock": "compact compile +0.31.1 contracts/MockUSDM.compact generated/mock-usdm",
    "compile:gateway": "compact compile +0.31.1 contracts/BalaryStablecoinGateway.compact generated/gateway",
    "compile:payroll": "compact compile +0.31.1 contracts/BalaryPayrollVault.compact generated/payroll",
    "test:compact": "vitest run src/**/*.compact.test.ts",
    "test:local": "MIDNIGHT_NETWORK=local vitest run src/local/**/*.local.test.ts",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "gate": "./scripts/quality-gate.sh",
    "local:gateway": "tsx src/local/gateway-flow.ts",
    "local:payroll": "tsx src/local/payroll-flow.ts",
    "local:claim": "tsx src/local/claim-flow.ts",
    "local:redeem": "tsx src/local/redeem-flow.ts",
    "preview:gateway": "tsx src/preview/gateway-flow.ts",
    "preview:payroll": "tsx src/preview/payroll-flow.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@via-labs-tech/usdm-bridge": "^1.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1"
  },
  "resolutions": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1"
  }
}
